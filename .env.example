# Copy to .env.local (gitignored). Expo loads it automatically.

# App: Storefront API (public token from the Headless channel)
SHOPIFY_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Which store config uses the live store (others stay on sample data)
SHOPIFY_STORE_ID=athlx

# Seed/report script only (never bundled into the app). Use a Dev Dashboard app's
# client credentials, or an Admin API access token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
